@echo off
chcp 65001 >nul
title Dungeon Ultimate

REM ============================================================================
REM  Портативный запуск. Собирать нечего: игра уже собрана.
REM  Всё живёт в этой папке — модели, сохранения, кадры, временные файлы.
REM  Удалил папку — удалил игру, в системе не остаётся ничего.
REM ============================================================================

set "ROOT=%~dp0"
cd /d "%ROOT%"
set "TEMP=%ROOT%temp"
set "TMP=%ROOT%temp"
if not exist "temp" mkdir "temp"

if "%DU_PORT%"=="" set "DU_PORT=8770"

echo.
echo   Dungeon Ultimate — http://127.0.0.1:%DU_PORT%
echo.
echo   Первый запуск: открой раздел «Что скачать» и дай игре забрать модели.
echo   Обязательное — около 17 ГБ, с озвучкой и распознаванием — около 23 ГБ.
echo   Прерванная загрузка продолжится с того же места.
echo.
echo   Окно закроешь — игра остановится.
echo.

start "" /b cmd /c "timeout /t 2 >nul & start http://127.0.0.1:%DU_PORT%"
"%ROOT%du-server.exe"

echo.
echo  Игра остановлена.
pause
