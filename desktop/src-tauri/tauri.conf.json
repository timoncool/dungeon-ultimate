{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dungeon Ultimate",
  "version": "0.1.0",
  "identifier": "com.dungeonultimate.desktop",
  "build": {
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "staging/frontend/dist": "frontend/dist",
      "staging/models/runtime/sd": "models/runtime/sd",
      "staging/tools/llama": "tools/llama"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
