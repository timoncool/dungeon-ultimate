@echo off
chcp 65001 >nul
setlocal enabledelayedexpansion
title Dungeon Ultimate — установка

REM ============================================================================
REM  Разовая установка. Собирает игру из исходников и готовит папки.
REM  Веса моделей отсюда НЕ качаются: их добирает сама игра на первом запуске,
REM  показывая размер и прогресс — так установщик не весит десятки гигабайт.
REM ============================================================================

set "ROOT=%~dp0"
cd /d "%ROOT%"
REM Временные файлы держим внутри папки игры: удалил папку — не осталось следов.
set "TEMP=%ROOT%temp"
set "TMP=%ROOT%temp"
for %%d in (temp downloads models generated uploads data) do if not exist "%%d" mkdir "%%d"

echo.
echo  ╔══════════════════════════════════════════════════════════╗
echo  ║              Dungeon Ultimate — установка                ║
echo  ╚══════════════════════════════════════════════════════════╝
echo.

REM ─── Rust ───────────────────────────────────────────────────────────────────
where cargo >nul 2>&1
if errorlevel 1 (
    echo  [!] Не найден Rust — им собирается сама игра.
    echo      Поставь его отсюда: https://rustup.rs
    echo      Затем закрой это окно и запусти install.bat снова.
    echo.
    pause
    exit /b 1
)
echo  [1/3] Rust на месте.

REM ─── Node ───────────────────────────────────────────────────────────────────
where npm >nul 2>&1
if errorlevel 1 (
    echo  [!] Не найден Node.js — им собирается интерфейс.
    echo      Поставь его отсюда: https://nodejs.org
    echo      Затем закрой это окно и запусти install.bat снова.
    echo.
    pause
    exit /b 1
)
echo  [2/3] Node.js на месте. Собираю интерфейс…
pushd frontend
call npm install --no-fund --no-audit || (echo  [!] npm install не прошёл & popd & pause & exit /b 1)
call npm run build || (echo  [!] сборка интерфейса не прошла & popd & pause & exit /b 1)
popd

REM ─── Сама игра ──────────────────────────────────────────────────────────────
echo  [3/3] Собираю игру. В первый раз это долго — Rust компилирует зависимости.
cargo build --release -p du-server || (echo  [!] сборка не прошла & pause & exit /b 1)

echo.
echo  ══════════════════════════════════════════════════════════
echo   Готово. Запускай run.bat.
echo.
echo   При первом запуске игра предложит скачать модели:
echo   обязательные — около 18 ГБ, с озвучкой и распознаванием — около 23 ГБ.
echo   Качается с докачкой: прерванная загрузка продолжится с того же места.
echo  ══════════════════════════════════════════════════════════
echo.
pause
